# Copy to .env and adjust for your machine. All values are optional;
# defaults target a local LM Studio server.

# LM Studio (OpenAI-compatible) endpoint
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Models as loaded in LM Studio
CHAT_MODEL=local-model
# Embedding model — use a MULTILINGUAL model so the mixed Turkish + English
# corpus shares one vector space. bge-m3 is verified working here; do NOT use an
# English-only model (e.g. nomic-embed-text) or Turkish retrieval degrades, and
# never mix models in one store — re-ingest from scratch if you switch.
EMBEDDING_MODEL=text-embedding-bge-m3

# Generation
TEMPERATURE=0.4
# Keep generous: reasoning-capable local builds spend tokens "thinking" before
# the visible answer, so a tight budget can return an empty reply.
MAX_TOKENS=2048

# Retrieval
RETRIEVAL_K=4
PRODUCT_MATCH_K=3

# CORS: "*" or comma-separated origins
CORS_ALLOW_ORIGINS=*

# --- Chat provider ---------------------------------------------------------
# "local" (default) uses the LM Studio server above. "openrouter" uses a hosted
# OpenAI-compatible endpoint instead.
CHAT_PROVIDER=local
# Required only when CHAT_PROVIDER=openrouter. Never commit a real key.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Embedding provider ----------------------------------------------------
# The store is stamped with a STABLE logical identity, so a hosted bge-m3
# endpoint (named e.g. "BAAI/bge-m3") is a clean config swap with NO re-index.
# EMBEDDING_IDENTITY must stay "bge-m3" as long as the vectors are bge-m3.
EMBEDDING_IDENTITY=bge-m3
# Leave EMBEDDING_BASE_URL / EMBEDDING_API_KEY empty for local (falls back to the
# LM_STUDIO_* values above). They fall back INDEPENDENTLY, so for a hosted
# deploy set BOTH to the real provider - setting only the base URL still sends
# the LM Studio dummy key to the provider (401).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Hosted-deploy example (uncomment + fill in for production) -------------
# CHAT_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai
# EMBEDDING_API_KEY=di-...
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_IDENTITY=bge-m3
# CORS_ALLOW_ORIGINS=https://your-site.example
