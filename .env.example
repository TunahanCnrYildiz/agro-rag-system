# Copy to .env and adjust for your machine. All values are optional;
# defaults target a local LM Studio server.

# LM Studio (OpenAI-compatible) endpoint
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Models as loaded in LM Studio
CHAT_MODEL=local-model
# Embedding model — use a MULTILINGUAL model so the mixed Turkish + English
# corpus shares one vector space. bge-m3 is verified working here; do NOT use an
# English-only model (e.g. nomic-embed-text) or Turkish retrieval degrades, and
# never mix models in one store — re-ingest from scratch if you switch.
EMBEDDING_MODEL=text-embedding-bge-m3

# Generation
TEMPERATURE=0.4
# Keep generous: reasoning-capable local builds spend tokens "thinking" before
# the visible answer, so a tight budget can return an empty reply.
MAX_TOKENS=2048

# Retrieval
RETRIEVAL_K=4
PRODUCT_MATCH_K=3

# CORS: "*" or comma-separated origins
CORS_ALLOW_ORIGINS=*
