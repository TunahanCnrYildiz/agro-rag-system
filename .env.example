# Copy to .env and adjust for your machine. All values are optional;
# defaults target a local LM Studio server.

# LM Studio (OpenAI-compatible) endpoint
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Models as loaded in LM Studio
CHAT_MODEL=local-model
# Embedding model — use a MULTILINGUAL model so the mixed Turkish + English
# corpus shares one vector space. bge-m3 is verified working here; do NOT use an
# English-only model (e.g. nomic-embed-text) or Turkish retrieval degrades, and
# never mix models in one store — re-ingest from scratch if you switch.
EMBEDDING_MODEL=text-embedding-bge-m3

# Generation
TEMPERATURE=0.4
# Keep generous: reasoning-capable local builds spend tokens "thinking" before
# the visible answer, so a tight budget can return an empty reply - or, worse,
# a reply cut off mid-sentence.
#
# Raised 2048 -> 3072 on 2026-08-13. At 2048 one generation in nine hit the
# ceiling and answers were being truncated in normal use. Measured at 3072
# across eight cases spanning every route: the heaviest was 1688 tokens, so
# roughly 1,400 remain unused. Do not raise it further without re-measuring the
# prompt: the window is 8192, and the worst case measured end to end is 4,681
# prompt tokens (the longest context block plus a mobile client's full 3,000
# characters of history), leaving only 439 spare at 3072. Overshooting truncates
# the PROMPT instead, which silently drops the system instructions and is the
# worse failure.
MAX_TOKENS=3072

# Retrieval
RETRIEVAL_K=4
PRODUCT_MATCH_K=3

# CORS: "*" or comma-separated origins
CORS_ALLOW_ORIGINS=*

# --- Chat provider ---------------------------------------------------------
# "local" (default) uses the LM Studio server above. "openrouter" uses a hosted
# OpenAI-compatible endpoint instead.
CHAT_PROVIDER=local
# Required only when CHAT_PROVIDER=openrouter. Never commit a real key.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Embedding provider ----------------------------------------------------
# The store is stamped with a STABLE logical identity, so a hosted bge-m3
# endpoint (named e.g. "BAAI/bge-m3") is a clean config swap with NO re-index.
# EMBEDDING_IDENTITY must stay "bge-m3" as long as the vectors are bge-m3.
EMBEDDING_IDENTITY=bge-m3
# Leave EMBEDDING_BASE_URL / EMBEDDING_API_KEY empty for local (falls back to the
# LM_STUDIO_* values above). They fall back INDEPENDENTLY, so for a hosted
# deploy set BOTH to the real provider - setting only the base URL still sends
# the LM Studio dummy key to the provider (401).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Hosted-deploy example (uncomment + fill in for production) -------------
# CHAT_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai
# EMBEDDING_API_KEY=di-...
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_IDENTITY=bge-m3
# CORS_ALLOW_ORIGINS=https://your-site.example

# --- Prebuilt vector store (first-boot bootstrap) ---------------------------
# NOTHING TO SET HERE. The archive URL and its checksum are already defaults in
# src/config.py, so a fresh clone or container fetches the right corpus on its
# own. These two lines exist only to point a deployment at a DIFFERENT source.
#
# Why it matters: re-fetching and re-ingesting does NOT reproduce the corpus -
# the Internet Archive returns different books over time - so a machine that
# builds its own store answers from a different, much smaller knowledge base.
#
# If you do override the URL, override the checksum with it. A truncated
# download yields a store that opens and answers badly rather than failing.
# VECTOR_STORE_URL=https://.../vector_store.zip
# VECTOR_STORE_SHA256=...
