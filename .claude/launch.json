{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-widget-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "web-widget"],
      "port": 8080
    },
    {
      "name": "mobile-app-web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "var p=require('path').resolve(process.cwd(),'mobile-app/node_modules/expo/bin/cli'); process.chdir('mobile-app'); process.argv=[process.argv[0],p,'start','--web','--port','8081']; require(p);"],
      "port": 8081
    }
  ]
}
