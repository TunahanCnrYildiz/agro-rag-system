# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env

# Vector store (persistent DB is large / regenerable)
data/vector_store/

# Source documents (books can be huge — keep out of git). The ** covers
# subdirectories too (e.g. docs/books/_offtopic/, .../lowrelevance/), which the
# bare docs/books/*.pdf did NOT — those quarantined PDFs showed as untracked.
docs/books/**/*.pdf
docs/books/**/*.txt

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local editor / tooling config (not part of the project)
.claude/
CLAUDE.md
AGENTS.md

# Local-only project notes (kept off the remote)
spec.md

# Logs
*.log

# Generated off-topic cleanup report (from `fetch_dergipark --clean-offtopic`)
docs/offtopic_candidates.txt

# Generated retrieval diagnostic report (from `evals.inspect_retrieval`)
docs/retrieval_report.md

# Per-run eval answer logs (from evals.answer_log)
evals/runs/
