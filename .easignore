# Files excluded from the EAS Build upload archive.
#
# Monorepo: Python RAG backend at the repo root, Expo app in mobile-app/. EAS
# archives from the git root, so without this it uploads ~1 GB of backend data
# and node_modules the app build does not need.
#
# IMPORTANT: root-level backend dirs are anchored with a leading "/" so they do
# NOT also match same-named dirs inside the app (e.g. an unanchored "src/" would
# wrongly exclude mobile-app/src/ and break the JS bundle).

# --- Python RAG backend (repo root only) ---
/data/
/docs/
/src/
/tests/
/requirements.txt

# --- Node / Expo / native build outputs (any level) ---
node_modules/
.expo/
/mobile-app/android/
/mobile-app/ios/
/mobile-app/builds/

# --- VCS ---
/.git/
